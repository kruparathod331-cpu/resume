# ==============================================================================
# KRUPA RATHOD PORTFOLIO — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# All features in this portfolio work out-of-the-box with offline fallbacks.
# If you wish to enable live AI LLM streaming or external contact webhook APIs,
# provide your secret keys below and rename this file to .env.local

# 1. Google Gemini API Key (Optional — for live LLM streaming in KrupaBot)
# Obtain from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# 2. Web3Forms or Formspree Access Key (Optional — for direct inbox form routing)
# Obtain free from: https://web3forms.com/ or https://formspree.io/
VITE_CONTACT_FORM_KEY=

# 3. GitHub Personal Access Token (Optional — to bypass public GitHub API rate limits)
# Obtain from: https://github.com/settings/tokens
VITE_GITHUB_TOKEN=
